  "html": "<!-- PRINT STYLES -->\n<style>\n    @media print { tr, .checkbox { page-break-inside: avoid; } thead { display: table-header-group; } }\n    * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n        color: #000 !important;\n        background: #fff !important;\n        font-family: Arial, sans-serif;\n        font-size: 10pt;\n    }\n\n    body {\n        width: 100%;\n        padding: 10mm 15mm;\n    }\n\n    .form-title {\n        text-align: center;\n        /*margin-bottom: 6px;*/\n    }\n\n    .form-title h3 {\n        font-size: 11pt;\n        font-weight: bold;\n        line-height: 0;\n        text-transform: uppercase;\n    }\n\n    table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 8px;\n    }\n\n    table.employee-section td {\n        padding: 4px 2px;\n        font-size: 10pt;\n        vertical-align: middle;\n        border: none;\n        line-height: 0.5;\n    }\n\n    table.items-table {\n        border: 1px solid #000;\n        margin-bottom: 6px;\n    }\n\n    table.items-table th,\n    table.items-table td {\n        border: 1px solid #000;\n        padding: 2px 2px;\n        font-size: 10pt;\n        vertical-align: top;\n    }\n\n    table.items-table thead th {\n        /*font-weight: bold;*/\n        text-align: center;\n        background: #fff !important;\n    }\n\n    table.items-table td.total-amount {\n        /*font-weight: bold;*/\n        text-align: right;\n    }\n\n    .line {\n        display: inline;\n        margin-left: 4px;\n        line-height: 0.5;\n    }\n\n    .line.long {\n        display: inline;\n        margin-left: 4px;\n    }\n\n    .salutation {\n        font-size: 10pt;\n    }\n\n    .checkbox {\n        display: inline-block;\n        width: 16px;\n        height: 16px;\n        border: 1px solid #000;\n        text-align: center;\n        line-height: 14px;\n        font-size: 12pt;\n        margin-left: 4px;\n        margin-top: -10px;\n        vertical-align: middle;\n    }\n\n    .section-title {\n        font-size: 10pt;\n        /*font-weight: bold;*/\n        margin: 10px 0 4px 0;\n        /*text-transform: uppercase;*/\n    }\n\n    .declaration {\n        margin: 14px 0 10px 0;\n        font-size: 10pt;\n        line-height: 1.5;\n        text-align: justify;\n        padding: 8px 10px;\n    }\n\n    .signature-section {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 40px;\n    }\n\n    .signature-section td {\n        width: 33.33%;\n        text-align: center;\n        padding: 0 10px;\n        vertical-align: bottom;\n        border: none;\n    }\n\n    .signature-line {\n        border-top: 1px solid #000;\n        padding-top: 4px;\n        font-size: 9.5pt;\n        margin-top: 10px;\n    }\n\n    .signature-line-blank {\n        border-top: 1px;\n        padding-top: 4px;\n        font-size: 9.5pt;\n        margin-top: 50px;\n    }\n\n    .print-meta {\n        font-size: 8pt;\n        color: #000;\n        text-align: right;\n        margin-bottom: 6px;\n    }\n\n    @media print {\n        @page {\n            size: A4 portrait;\n            margin: 15mm 15mm 15mm 15mm;\n        }\n\n        body {\n            padding: 0;\n        }\n\n        * {\n            -webkit-print-color-adjust: exact;\n            print-color-adjust: exact;\n        }\n    }\n</style>\n\n<!-- TIMESTAMP -->\n<div class=\"print-meta\">\n    {{ frappe.utils.now_datetime().strftime(\"%Y-%m-%d %H:%M:%S\") }}\n</div>\n\n<!-- HEADER -->\n<div class=\"form-title\">\n    <h3>STAFF MEDICAL SUPPORT SCHEME</h3>\n    <h3>APPLICATION FOR REIMBURSEMENT OF MEDICAL EXPENSES</h3>\n    <h3>OPD TREATMENT/SPECTACLES</h3>\n</div>\n\n{% set ins_mem = frappe.get_doc(\"Insurance Member\", doc.employee) %}\n{% set emp = frappe.get_doc(\"Employee\", ins_mem.employee) %}\n{% set emp_scheme = frappe.get_doc(\"Support Scheme\", ins_mem.insurance_scheme) %}\n\n<table class=\"employee-section\">\n    <tr>\n        <td colspan=\"3\"></td>\n        <td style=\"text-align: right\">\n            Claim No:\n            <span class=\"line\">{{ doc.name }}</span>\n        </td>\n    </tr>\n</table>\n\n<table class=\"employee-section\">\n    <tr>\n        <td>\n            EMP. No:\n            <span class=\"line\">{{ ins_mem.employee }}</span>\n        </td>\n        <td>\n            Scheme I\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme I\" %}✓{% endif %}</span>\n        </td>\n        <td>\n            Scheme II\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme II\" %}✓{% endif %}</span>\n        </td>\n        <td>\n            Scheme III\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme III\" %}✓{% endif %}</span>\n        </td>\n    </tr>\n</table>\n\n<table class=\"employee-section\">\n    <tr>\n        <td colspan=\"2\">\n            Name of Applicant:\n            <span class=\"salutation\">{{ emp.salutation }} </span>\n            <span class=\"line long\">{{ ins_mem.employee_name }}</span>\n        </td>\n    </tr>\n    <tr>\n        <td>\n            Designation:\n            <span class=\"line\">{{ emp.designation or \"\" }}</span>\n        </td>\n    </tr>\n    <tr>\n        {% if emp.department %}\n            <td>\n                Department:\n                <span class=\"line\">{{ emp.department or \"\" }}</span>\n            </td>\n        {% endif %}\n        \n        {% if emp.branch %}\n            <td>\n                Division:\n                <span class=\"line\">{{ emp.branch or \"\" }}</span>\n            </td>\n        {% endif %}\n    </tr>\n    <tr>\n        <td>\n            Telephone No:\n            <span class=\"line\">{{ emp.cell_number or \"\" }}</span>\n        </td>\n        <!--<td>-->\n        <!--    Agrahara Member:-->\n        <!--    <span class=\"line\">{{ \"Yes\" if ins_mem.agrahara_member else \"No\" }}</span>-->\n        <!--</td>-->\n    </tr>\n</table>\n\n<!-- BILL DETAILS -->\n<div class=\"section-title\">Details regarding bills</div>\n<table class=\"items-table\">\n    <thead>\n        <tr>\n            <th style=\"width:4%\">No</th>\n            <th style=\"width:10%\">Bill No</th>\n            <th style=\"width:12%\">Date</th>\n            <th style=\"width:28%\">Description / Purpose</th>\n            <th style=\"width:20%\">Doctor</th>\n            <th style=\"width:16%\">Patient</th>\n            <th style=\"width:10%; text-align:right\">Amount</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for item in doc.details_regarding_bills %}\n        <tr>\n            <td>{{ loop.index }}</td>\n            <td>{{ item.bill_no or '' }}</td>\n            <td>{{ item.issue_date or '' }}</td>\n            <td>{{ item.purpose or '' }}</td>\n            <td>{{ item.doctors_name or '' }}</td>\n            <td>{{ item.patiants_name or '' }}</td>\n            <td style=\"text-align:right\">{{ \"{:,.2f}\".format(item.amount or 0) }}</td>\n        </tr>\n        {% endfor %}\n        <tr>\n            <td colspan=\"6\" style=\"text-align:right\">Total</td>\n            <td class=\"total-amount\">{{ \"{:,.2f}\".format(doc.amount_m or 0) }}</td>\n        </tr>\n    </tbody>\n</table>\n\n<!-- DECLARATION -->\n<div class=\"declaration\">\n    I hereby state that I have claimed <b>Rs. {{ \"{:,.2f}\".format(doc.amount_m or 0) }}</b> as Medical expenses as aforesaid and that the Information provided in the claim form are true and accurate.\n</div>\n\n<!-- SIGNATURES -->\n<table class=\"signature-section\">\n    <tr>\n        <td>\n            <div class=\"line\">Date: {{ frappe.utils.now_datetime().strftime(\"%Y-%m-%d\") }}</div>\n        </td>\n        <td>\n            <div class=\"signature-line-blank\"></div>\n        </td>\n        <td>\n            <div class=\"signature-line\">Signature of Applicant</div>\n        </td>\n    </tr>\n</table>",
