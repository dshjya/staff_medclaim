  "html": "<!-- PRINT STYLES -->\r\n<style>\r\n    * {\r\n        margin: 0;\r\n        padding: 0;\r\n        box-sizing: border-box;\r\n        color: #000 !important;\r\n        background: #fff !important;\r\n        font-family: Arial, sans-serif;\r\n        font-size: 10pt;\r\n    }\r\n\r\n    body {\r\n        width: 100%;\r\n        padding: 10mm 15mm;\r\n    }\r\n\r\n    .form-title {\r\n        text-align: center;\r\n        /*margin-bottom: 6px;*/\r\n    }\r\n\r\n    .form-title h3 {\r\n        font-size: 11pt;\r\n        font-weight: bold;\r\n        line-height: 0;\r\n        text-transform: uppercase;\r\n    }\r\n\r\n    table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-bottom: 8px;\r\n    }\r\n\r\n    table.employee-section td {\r\n        padding: 4px 2px;\r\n        font-size: 10pt;\r\n        vertical-align: middle;\r\n        border: none;\r\n        line-height: 0.5;\r\n    }\r\n\r\n    table.items-table {\r\n        border: 1px solid #000;\r\n        margin-bottom: 6px;\r\n    }\r\n\r\n    table.items-table th,\r\n    table.items-table td {\r\n        border: 1px solid #000;\r\n        padding: 2px 2px;\r\n        font-size: 10pt;\r\n        vertical-align: top;\r\n    }\r\n\r\n    table.items-table thead th {\r\n        /*font-weight: bold;*/\r\n        text-align: center;\r\n        background: #fff !important;\r\n    }\r\n\r\n    table.items-table td.total-amount {\r\n        /*font-weight: bold;*/\r\n        text-align: right;\r\n    }\r\n\r\n    .line {\r\n        display: inline;\r\n        margin-left: 4px;\r\n        line-height: 0.5;\r\n    }\r\n\r\n    .line.long {\r\n        display: inline;\r\n        margin-left: 4px;\r\n    }\r\n\r\n    .salutation {\r\n        font-size: 10pt;\r\n    }\r\n\r\n    .checkbox {\r\n        display: inline-block;\r\n        width: 16px;\r\n        height: 16px;\r\n        border: 1px solid #000;\r\n        text-align: center;\r\n        line-height: 14px;\r\n        font-size: 12pt;\r\n        margin-left: 4px;\r\n        margin-top: -10px;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    .section-title {\r\n        font-size: 10pt;\r\n        /*font-weight: bold;*/\r\n        margin: 10px 0 4px 0;\r\n        /*text-transform: uppercase;*/\r\n    }\r\n\r\n    .declaration {\r\n        margin: 14px 0 10px 0;\r\n        font-size: 10pt;\r\n        line-height: 1.5;\r\n        text-align: justify;\r\n        padding: 8px 10px;\r\n    }\r\n\r\n    .signature-section {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-top: 40px;\r\n    }\r\n\r\n    .signature-section td {\r\n        width: 33.33%;\r\n        text-align: center;\r\n        padding: 0 10px;\r\n        vertical-align: bottom;\r\n        border: none;\r\n    }\r\n\r\n    .signature-line {\r\n        border-top: 1px solid #000;\r\n        padding-top: 4px;\r\n        font-size: 9.5pt;\r\n        margin-top: 10px;\r\n    }\r\n\r\n    .signature-line-blank {\r\n        border-top: 1px;\r\n        padding-top: 4px;\r\n        font-size: 9.5pt;\r\n        margin-top: 50px;\r\n    }\r\n\r\n    .print-meta {\r\n        font-size: 8pt;\r\n        color: #000;\r\n        text-align: right;\r\n        margin-bottom: 6px;\r\n    }\r\n\r\n    @media print {\r\n        @page {\r\n            size: A4 portrait;\r\n            margin: 15mm 15mm 15mm 15mm;\r\n        }\r\n\r\n        body {\r\n            padding: 0;\r\n        }\r\n\r\n        * {\r\n            -webkit-print-color-adjust: exact;\r\n            print-color-adjust: exact;\r\n        }\r\n    }\r\n</style>\r\n\r\n<!-- TIMESTAMP -->\r\n<div class=\"print-meta\">\r\n    {{ frappe.utils.now_datetime().strftime(\"%Y-%m-%d %H:%M:%S\") }}\r\n</div>\r\n\r\n<!-- HEADER -->\r\n<div class=\"form-title\">\r\n    <h3>STAFF MEDICAL SUPPORT SCHEME</h3>\r\n    <h3>APPLICATION FOR REIMBURSEMENT OF MEDICAL EXPENSES</h3>\r\n    <h3>OPD TREATMENT/SPECTACLES</h3>\r\n</div>\r\n\r\n{% set ins_mem = frappe.get_doc(\"Insurance Member\", doc.employee) %}\r\n{% set emp = frappe.get_doc(\"Employee\", ins_mem.employee) %}\r\n{% set emp_scheme = frappe.get_doc(\"Support Scheme\", ins_mem.insurance_scheme) %}\r\n\r\n<table class=\"employee-section\">\r\n    <tr>\r\n        <td colspan=\"3\"></td>\r\n        <td style=\"text-align: right\">\r\n            Claim No:\r\n            <span class=\"line\">{{ doc.name }}</span>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<table class=\"employee-section\">\r\n    <tr>\r\n        <td>\r\n            EMP. No:\r\n            <span class=\"line\">{{ ins_mem.employee }}</span>\r\n        </td>\r\n        <td>\r\n            Scheme I\r\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme I\" %}\u2713{% endif %}</span>\r\n        </td>\r\n        <td>\r\n            Scheme II\r\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme II\" %}\u2713{% endif %}</span>\r\n        </td>\r\n        <td>\r\n            Scheme III\r\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme III\" %}\u2713{% endif %}</span>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<table class=\"employee-section\">\r\n    <tr>\r\n        <td colspan=\"2\">\r\n            Name of Applicant:\r\n            <span class=\"salutation\">{{ emp.salutation }} </span>\r\n            <span class=\"line long\">{{ ins_mem.employee_name }}</span>\r\n        </td>\r\n    </tr>\r\n    <tr>\r\n        <td>\r\n            Designation:\r\n            <span class=\"line\">{{ emp.designation or \"\" }}</span>\r\n        </td>\r\n    </tr>\r\n    <tr>\r\n        {% if emp.department %}\r\n            <td>\r\n                Department:\r\n                <span class=\"line\">{{ emp.department or \"\" }}</span>\r\n            </td>\r\n        {% endif %}\r\n        \r\n        {% if emp.branch %}\r\n            <td>\r\n                Division:\r\n                <span class=\"line\">{{ emp.branch or \"\" }}</span>\r\n            </td>\r\n        {% endif %}\r\n    </tr>\r\n    <tr>\r\n        <td>\r\n            Telephone No:\r\n            <span class=\"line\">{{ emp.cell_number or \"\" }}</span>\r\n        </td>\r\n        <!--<td>-->\r\n        <!--    Agrahara Member:-->\r\n        <!--    <span class=\"line\">{{ \"Yes\" if ins_mem.agrahara_member else \"No\" }}</span>-->\r\n        <!--</td>-->\r\n    </tr>\r\n</table>\r\n\r\n<!-- BILL DETAILS -->\r\n<div class=\"section-title\">Details regarding bills</div>\r\n<table class=\"items-table\">\r\n    <thead>\r\n        <tr>\r\n            <th style=\"width:4%\">No</th>\r\n            <th style=\"width:10%\">Bill No</th>\r\n            <th style=\"width:12%\">Date</th>\r\n            <th style=\"width:28%\">Description / Purpose</th>\r\n            <th style=\"width:20%\">Doctor</th>\r\n            <th style=\"width:16%\">Patient</th>\r\n            <th style=\"width:10%; text-align:right\">Amount</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% for item in doc.details_regarding_bills %}\r\n        <tr>\r\n            <td>{{ loop.index }}</td>\r\n            <td>{{ item.bill_no or '' }}</td>\r\n            <td>{{ item.issue_date or '' }}</td>\r\n            <td>{{ item.purpose or '' }}</td>\r\n            <td>{{ item.doctors_name or '' }}</td>\r\n            <td>{{ item.patiants_name or '' }}</td>\r\n            <td style=\"text-align:right\">{{ \"{:,.2f}\".format(item.amount or 0) }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n        <tr>\r\n            <td colspan=\"6\" style=\"text-align:right\">Total</td>\r\n            <td class=\"total-amount\">{{ \"{:,.2f}\".format(doc.amount_m or 0) }}</td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n\r\n<!-- DECLARATION -->\r\n<div class=\"declaration\">\r\n    I hereby state that I have claimed <b>Rs. {{ \"{:,.2f}\".format(doc.amount_m or 0) }}</b> as Medical expenses as aforesaid and that the Information provided in the claim form are true and accurate.\r\n</div>\r\n\r\n<!-- SIGNATURES -->\r\n<table class=\"signature-section\">\r\n    <tr>\r\n        <td>\r\n            <div class=\"line\">Date: {{ frappe.utils.now_datetime().strftime(\"%Y-%m-%d\") }}</div>\r\n        </td>\r\n        <td>\r\n            <div class=\"signature-line-blank\"></div>\r\n        </td>\r\n        <td>\r\n            <div class=\"signature-line\">Signature of Applicant</div>\r\n        </td>\r\n    </tr>\r\n</table>",
