  "html": "<!-- Insurance Claim - Surgical & Hospital -->\n\n<!-- PRINT STYLES -->\n<style>\n    @media print { tr, .checkbox { page-break-inside: avoid; } thead { display: table-header-group; } }\n    * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n        color: #000 !important;\n        background: #fff !important;\n        font-family: Arial, sans-serif;\n        font-size: 10pt;\n    }\n\n    body {\n        width: 100%;\n        \n    }\n    \n    .form-title{\n        text-align: center;\n    }\n\n    .form-title h4.italic {\n        font-style: italic;\n    }\n\n    table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 6px;\n    }\n\n    table.top-row td {\n        padding: 3px 3px;\n        font-size: 9pt;\n        vertical-align: middle;\n        border: none;\n    }\n    \n    table.employee-section td {\n        padding: 4px 2px;\n        font-size: 10pt;\n        vertical-align: middle;\n        border: none;\n        line-height: 0.5;\n    }\n\n    .section-title {\n        font-size: 9pt;\n        font-weight: bold;\n        margin: 10px 0 4px 0;\n        text-transform: uppercase;\n    }\n\n    /* All blank lines are now dotted */\n    .dotted-line {\n        border-bottom: 1px dotted #000;\n        display: inline-block;\n        min-width: 200px;\n        margin-left: 4px;\n        vertical-align: bottom;\n    }\n\n    .dotted-line.short {\n        min-width: 80px;\n    }\n\n    .dotted-line.medium {\n        min-width: 140px;\n    }\n\n    .dotted-line.long {\n        min-width: 300px;\n    }\n\n    .dotted-line.full {\n        min-width: 98%;\n        display: block;\n        margin-top: 2px;\n    }\n\n    .checkbox {\n        display: inline-block;\n        width: 16px;\n        height: 16px;\n        border: 1px solid #000;\n        text-align: center;\n        line-height: 14px;\n        font-size: 12pt;\n        margin-left: 4px;\n        margin-top: -10px;\n        vertical-align: middle;\n    }\n\n    .numbered-item {\n        display: flex;\n        align-items: flex-start;\n        margin-bottom: 6px;\n        font-size: 9pt;\n    }\n\n    .numbered-item .num {\n        min-width: 20px;\n        font-weight: normal;\n    }\n\n    /* Content row becomes a flex row so any dotted-line inside\n       grows to fill remaining space and ends flush on the right */\n    .numbered-item .content {\n        flex: 1;\n        display: flex;\n        align-items: flex-end;\n        flex-wrap: wrap;\n        gap: 4px;\n    }\n\n    .numbered-item .content > .dotted-line {\n        flex: 1;\n        min-width: 60px;\n        margin-left: 0;\n    }\n\n    .lettered-item {\n        display: flex;\n        align-items: flex-start;\n        margin-bottom: 6px;\n        font-size: 9pt;\n        padding-left: 20px;\n    }\n\n    .lettered-item .ltr {\n        min-width: 24px;\n    }\n\n    .lettered-item .content {\n        flex: 1;\n        display: flex;\n        align-items: flex-end;\n        flex-wrap: wrap;\n        gap: 4px;\n    }\n\n    /* .full lines already stretch to 98% width on their own row,\n       so only non-full dotted-lines need the flex-grow treatment */\n    .lettered-item .content > .dotted-line:not(.full) {\n        flex: 1;\n        min-width: 60px;\n        margin-left: 0;\n    }\n\n    .general-info-item {\n        font-size: 9pt;\n        margin-bottom: 4px;\n        line-height: 1.5;\n        display: flex;\n        align-items: flex-end;\n        flex-wrap: wrap;\n        gap: 4px;\n    }\n\n    .general-info-item > .dotted-line {\n        flex: 1;\n        min-width: 60px;\n        margin-left: 0;\n    }\n\n    .declaration {\n        margin: 14px 0 10px 0;\n        font-size: 9pt;\n        line-height: 1.7;\n        text-align: justify;\n        padding: 4px 0;\n    }\n\n    .signature-section {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 20px;\n        margin-bottom: 14px;\n    }\n\n    .signature-section td {\n        padding: 0 4px;\n        vertical-align: bottom;\n        border: none;\n        font-size: 9pt;\n    }\n\n    .signature-section .field-row {\n        display: flex;\n        align-items: flex-end;\n        gap: 4px;\n    }\n\n    .signature-section .field-row .dotted-line {\n        flex: 1;\n        min-width: 60px;\n        margin-left: 0;\n    }\n\n    .signature-line {\n        border-top: 1px solid #000;\n        padding-top: 4px;\n        font-size: 8.5pt;\n        margin-top: 40px;\n    }\n\n    .total-amount-row {\n        margin: 10px 0;\n        font-size: 9pt;\n        font-weight: bold;\n    }\n\n    .practitioner-section {\n        margin-top: 14px;\n    }\n\n    .practitioner-section .section-header {\n        font-size: 9pt;\n        font-weight: bold;\n        text-transform: uppercase;\n        margin-bottom: 10px;\n    }\n\n    .practitioner-footer {\n        margin-top: 14px;\n        font-size: 9pt;\n        line-height: 1.7;\n    }\n\n    .practitioner-footer .sig-right {\n        text-align: right;\n        font-size: 9pt;\n        font-weight: bold;\n        margin: 16px 0 30px 0;\n    }\n\n    .print-meta {\n        font-size: 8pt;\n        color: #000;\n        text-align: right;\n        margin-bottom: 6px;\n    }\n\n    .italic-note {\n        font-style: italic;\n        font-size: 8.5pt;\n    }\n\n    .period-row {\n        display: flex;\n        gap: 40px;\n        font-size: 9pt;\n        margin-bottom: 8px;\n    }\n\n    /* Period of hospitalization fields, right-aligned dotted lines */\n    .period-fields {\n        display: flex;\n        gap: 20px;\n        flex-wrap: wrap;\n        padding-left: 20px;\n        margin-bottom: 8px;\n        font-size: 9pt;\n    }\n\n    .period-fields .sub-field {\n        display: flex;\n        align-items: flex-end;\n        flex: 1;\n        gap: 4px;\n    }\n\n    .period-fields .sub-field .dotted-line {\n        flex: 1;\n        min-width: 60px;\n        margin-left: 0;\n    }\n\n    hr.divider {\n        border: none;\n        border-top: 1px solid #000;\n        margin: 12px 0;\n    }\n\n    @media print {\n        @page {\n            size: A4 portrait;\n            margin: 15mm 15mm 15mm 15mm;\n        }\n\n        body {\n            padding: 0;\n        }\n\n        * {\n            -webkit-print-color-adjust: exact;\n            print-color-adjust: exact;\n        }\n    }\n</style>\n\n\n\n<!-- HEADER -->\n<div class=\"form-title\" style=\"position: relative;\">\n    <h4>University of Colombo School of Computing</h4>\n    <h4>Staff Medical Support Scheme – {{ (frappe.db.get_value(\"Insurance Period\", doc.insurance_period, \"year\") if doc.insurance_period else None) or frappe.utils.getdate(doc.creation).year }}</h4>\n    <h4 class=\"italic\">Surgical and Hospital Expenses Claim Form</h4>\n</div>\n\n{% set ins_mem = frappe.get_doc(\"Insurance Member\", doc.employee) %}\n{% set emp = frappe.get_doc(\"Employee\", ins_mem.employee) %}\n{% set emp_scheme = frappe.get_doc(\"Support Scheme\", ins_mem.insurance_scheme) %}\n\n<!-- TOP ROW: EMP No, Scheme checkboxes, S.No -->\n<table class=\"employee-section\">\n    <tr>\n        <td colspan=\"3\"></td>\n        <td style=\"text-align: right\">\n            Claim No:\n            <span class=\"line\">{{ doc.name }}</span>\n        </td>\n    </tr>\n</table>\n\n<table class=\"employee-section\">\n    <tr>\n        <td>\n            EMP. No:\n            <span class=\"line\">{{ ins_mem.employee }}</span>\n        </td>\n        <td>\n            Scheme I\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme I\" %}✓{% endif %}</span>\n        </td>\n        <td>\n            Scheme II\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme II\" %}✓{% endif %}</span>\n        </td>\n        <td>\n            Scheme III\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme III\" %}✓{% endif %}</span>\n        </td>\n    </tr>\n</table>\n\n<!-- EMPLOYEE'S SECTION -->\n<div class=\"section-title\">Employee Details</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">1.</span>\n    <span class=\"content\">\n        Name :\n        <span>{{ emp.salutation }} {{ ins_mem.employee_name }}</span>\n    </span>\n</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">2.</span>\n    <span class=\"content\">\n        Designation :\n        <span>{{ emp.designation or '' }}</span>\n    </span>\n</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">3.</span>\n    <span class=\"content\">\n        Employee Category :\n        <span>{{ emp.employee_category or '' }}</span>\n    </span>\n</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">4.</span>\n    <span class=\"content\" style=\"display:flex; gap:20px;\">\n        {% if emp.department %}\n            <span>Department : <span>{{ emp.department }}</span></span>\n        {% endif %}\n        \n        {% if emp.branch %}\n            <span>Division : <span>{{ emp.branch }}</span></span>\n        {% endif %}\n        <!--<span>Age: <span class=\"dotted-line short\"></span></span>-->\n    </span>\n</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">5.</span>\n    <span class=\"content\">\n        Address :\n        <span>{{ emp.permanent_address or '' }}</span>\n    </span>\n</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">6.</span>\n    <span class=\"content\" style=\"display:flex; gap:10px; flex-wrap:wrap;\">\n        <span>Telephone No : <span>{{ emp.cell_number or '' }}</span></span>\n        \n    </span>\n</div>\n\n{% if doc.dependent_name %}\n    <!-- DEPENDANT SECTION -->\n    <div class=\"section-title\">Dependant – <span style=\"font-weight:normal; text-transform:none;\">(Subject in respect of whom claim is made)</span></div>\n    \n    <div class=\"numbered-item\">\n        <span class=\"num\">1.</span>\n        <span class=\"content\">\n            Name :\n            <span>{{ doc.dependent_name.split('(')[0].rstrip() or '' }}</span>\n        </span>\n    </div>\n    \n    <div class=\"numbered-item\">\n        <span class=\"num\">2.</span>\n        <span class=\"content\">\n            Relationship:\n            <span>{{ doc.dependent_name.split('(')[1].split(')')[0] or '' }}</span>\n        </span>\n    </div>\n{% endif %}\n\n\n<!-- INJURY SECTION -->\n<div class=\"section-title\">Injury – <span style=\"font-weight:normal; text-transform:none;\">please state</span></div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">1.</span>\n    <span class=\"content\">\n        Date and place of Accident:\n        <span class=\"dotted-line long\">{{ doc.date_of_accident or '' }} {{ doc.place_of_accident or '' }}</span>\n    </span>\n</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">2.</span>\n    <span class=\"content\">\n        Precisely how the Accident occurred:\n        <span class=\"dotted-line long\">{{ doc.precisely_how_the_accident_occurred or '' }}</span>\n    </span>\n</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">3.</span>\n    <span class=\"content\">\n        Nature and Extent of Injuries:\n        <span class=\"dotted-line long\">{{ doc.nature_and_extent_of_injuries or '' }}</span>\n    </span>\n</div>\n\n<!-- ILLNESS SECTION -->\n<div class=\"section-title\">Illness – <span style=\"font-weight:normal; text-transform:none;\">please state</span></div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">1.</span>\n    <span class=\"content\">\n        Nature of Description of illness:\n        <span class=\"dotted-line long\">{{ doc.nature_of_description_of_illness or '' }}</span>\n    </span>\n</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">2.</span>\n    <span class=\"content\">\n        Date of Commencement of illness:\n        <span class=\"dotted-line medium\">{{ doc.date_of_commencement_of_illness or '' }}</span>\n    </span>\n</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">3.</span>\n    <span class=\"content\">\n        Date of first consultation regarding this illness:\n        <span class=\"dotted-line medium\">{{ doc.date_of_first_consultation_regarding_this_illness or '' }}</span>\n    </span>\n</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">4.</span>\n    <span class=\"content\">\n        Name &amp; the address of doctor who was first consulted:\n        <span class=\"dotted-line long\">{{ doc.name_and_the_address_of_doctor_who_was_first_consulted or '' }}</span>\n    </span>\n</div>\n\n<!-- PERIOD OF HOSPITALIZATION -->\n<div class=\"section-title\">Period of Hospitalization</div>\n<div class=\"period-fields\">\n    <span class=\"sub-field\">\n        From: <span class=\"dotted-line medium\">{{ doc.from or '' }}</span>\n    </span>\n    <span class=\"sub-field\">\n        To: <span class=\"dotted-line medium\">{{ doc.to or '' }}</span>\n    </span>\n</div>\n\n<!-- GENERAL INFORMATION -->\n<div class=\"section-title\">General Information</div>\n\n<div class=\"general-info-item\">Have you ever had the same illness before?\n    <span class=\"dotted-line long\">{{ \"Yes\" if doc.checkbox_1 else \"No\" }}</span></div>\n\n{% if doc.checkbox_1 %}    \n    <div class=\"general-info-item\">If so, give the particulars and date\n        <span class=\"dotted-line long\">{{ doc.previous_illness or '' }}</span>\n    </div>\n{% endif %}\n\n<div class=\"general-info-item\">Have you during the past five years had any illness or accident necessitating medical attention?\n    <span class=\"dotted-line long\">{{ \"Yes\" if doc.checkbox_2 else \"No\" }}</span></div>\n    \n{% if doc.checkbox_2 %}    \n    <div class=\"general-info-item\">If so, give full particulars\n        <span class=\"dotted-line long\">{{ doc.past_illness or '' }}</span>\n    </div>\n{% endif %}\n\n<div class=\"general-info-item\">Have you previously suffered from sickness accident injury, which has given rise to a claim to any insurance company or upon any benefit/society Fund?\n    <span class=\"dotted-line long\">{{ \"Yes\" if doc.checkbox_3 else \"No\" }}</span></div>\n\n{% if doc.checkbox_3 %}      \n    <div class=\"general-info-item\">If so, give full particulars\n        <span class=\"dotted-line long\">{{ doc.previous_insurance_claim or '' }}</span>\n    </div>\n{% endif %}\n\n<div class=\"general-info-item\">Any claims pending or are you entitled to claim upon any other insurer, Society of fund in respect of any illness or any injury suffered by you?\n    <span class=\"dotted-line long\">{{ \"Yes\" if doc.checkbox_4 else \"No\" }}</span></div>\n    \n<div class=\"general-info-item\">If you are undergoing treatment for the injury or illness to which this claim relates, please state?\n    <span class=\"dotted-line long\">{{ \"Yes\" if doc.checkbox_6 else \"No\" }}</span></div>\n\n{% if doc.checkbox_6 %}\n    <div class=\"lettered-item\">\n        <span class=\"ltr\">a.</span>\n        <span class=\"content\">Nature of illness\n            <span class=\"dotted-line long\">{{ doc.nature_of_illness or '' }}</span>\n        </span>\n    </div>\n    \n    <div class=\"lettered-item\">\n        <span class=\"ltr\">b.</span>\n        <span class=\"content\">Nature of treatment\n            <span class=\"dotted-line long\">{{ doc.nature_of_treatment or '' }}</span>\n        </span>\n    </div>\n    \n    <div class=\"lettered-item\">\n        <span class=\"ltr\">c.</span>\n        <span class=\"content\">Name of hospital concerned if any\n            <span class=\"dotted-line long\">{{ doc.name_of_hospital_concerned_if_any or '' }}</span>\n        </span>\n    </div>\n    \n    <div class=\"lettered-item\">\n        <span class=\"ltr\">d.</span>\n        <span class=\"content\">Name of any Consulting Specialists Whose recommended treatment you or have been receiving giving details of the treatment concerned and other Specialist services received.\n           <br><br><span class=\"dotted-line full\">{{ doc.other_details or '' }}</span>\n        </span>\n    </div>\n{% endif %}\n\n<!-- DECLARATION -->\n<div class=\"declaration\">\n    I HEREBY DECLARE that I have received the injuries above described and suffering from illness as above described, and I claim reimbursement under the above Medical Welfare Scheme in respect thereof I hereby warrant that the above statements and facts are true and that I have not withheld from the University any material information connected with this claim.\n</div>\n\n<!-- APPLICANT SIGNATURE -->\n<!--<table class=\"signature-section\">-->\n<!--    <tr>-->\n<!--        <td style=\"padding-top:10px;\">-->\n<!--            <span class=\"field-row\">Date: <span>{{ frappe.utils.today() }}</span></span>-->\n<!--        </td>-->\n<!--        <td></td>-->\n<!--        <td style=\"width:50%\">-->\n<!--            <span class=\"field-row\">Applicant (Signature): <span class=\"dotted-line medium\"></span></span>-->\n<!--        </td>-->\n<!--        <td style=\"width:50%\"></td>-->\n        \n        \n<!--    </tr>-->\n<!--</table>-->\n\n<table style=\"margin-top:16px; margin-bottom:0;\">\n    <tr>\n        <td style=\"width:70%; vertical-align:top;\">\n            Date: <span>{{ frappe.utils.today() }}</span></span>\n           \n        </td>\n        <td style=\"width:30%; text-align:right; vertical-align:bottom;\">\n            <div style=\"margin-top:20px; border-top:1px dotted #000; padding-top:4px;\"></div>\n            <div style=\"font-weight:bold; font-size:10pt;  text-align:center;\">\n                Applicant (Signature)\n            </div>\n        </td>\n    </tr>\n</table>\n\n<!-- TOTAL AMOUNT -->\n<div class=\"total-amount-row\" style=\"margin-top:16px;\">\n    Total Amount of all receipts (bills): Rs.&nbsp;\n    <span style=\"border-bottom:1px dotted #000; padding:0 6px;\">\n        {{ \"{:,.2f}\".format(doc.amount or 0) }}\n    </span>\n</div>",
