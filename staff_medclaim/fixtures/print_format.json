  "html": "<!-- Insurance Claim - Surgical & Hospital -->\r\n\r\n<!-- PRINT STYLES -->\r\n<style>\r\n    * {\r\n        margin: 0;\r\n        padding: 0;\r\n        box-sizing: border-box;\r\n        color: #000 !important;\r\n        background: #fff !important;\r\n        font-family: Arial, sans-serif;\r\n        font-size: 10pt;\r\n    }\r\n\r\n    body {\r\n        width: 100%;\r\n        \r\n    }\r\n    \r\n    .form-title{\r\n        text-align: center;\r\n    }\r\n\r\n    .form-title h4.italic {\r\n        font-style: italic;\r\n    }\r\n\r\n    table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-bottom: 6px;\r\n    }\r\n\r\n    table.top-row td {\r\n        padding: 3px 3px;\r\n        font-size: 9pt;\r\n        vertical-align: middle;\r\n        border: none;\r\n    }\r\n    \r\n    table.employee-section td {\r\n        padding: 4px 2px;\r\n        font-size: 10pt;\r\n        vertical-align: middle;\r\n        border: none;\r\n        line-height: 0.5;\r\n    }\r\n\r\n    .section-title {\r\n        font-size: 9pt;\r\n        font-weight: bold;\r\n        margin: 10px 0 4px 0;\r\n        text-transform: uppercase;\r\n    }\r\n\r\n    /* All blank lines are now dotted */\r\n    .dotted-line {\r\n        border-bottom: 1px dotted #000;\r\n        display: inline-block;\r\n        min-width: 200px;\r\n        margin-left: 4px;\r\n        vertical-align: bottom;\r\n    }\r\n\r\n    .dotted-line.short {\r\n        min-width: 80px;\r\n    }\r\n\r\n    .dotted-line.medium {\r\n        min-width: 140px;\r\n    }\r\n\r\n    .dotted-line.long {\r\n        min-width: 300px;\r\n    }\r\n\r\n    .dotted-line.full {\r\n        min-width: 98%;\r\n        display: block;\r\n        margin-top: 2px;\r\n    }\r\n\r\n    .checkbox {\r\n        display: inline-block;\r\n        width: 16px;\r\n        height: 16px;\r\n        border: 1px solid #000;\r\n        text-align: center;\r\n        line-height: 14px;\r\n        font-size: 12pt;\r\n        margin-left: 4px;\r\n        margin-top: -10px;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    .numbered-item {\r\n        display: flex;\r\n        align-items: flex-start;\r\n        margin-bottom: 6px;\r\n        font-size: 9pt;\r\n    }\r\n\r\n    .numbered-item .num {\r\n        min-width: 20px;\r\n        font-weight: normal;\r\n    }\r\n\r\n    /* Content row becomes a flex row so any dotted-line inside\r\n       grows to fill remaining space and ends flush on the right */\r\n    .numbered-item .content {\r\n        flex: 1;\r\n        display: flex;\r\n        align-items: flex-end;\r\n        flex-wrap: wrap;\r\n        gap: 4px;\r\n    }\r\n\r\n    .numbered-item .content > .dotted-line {\r\n        flex: 1;\r\n        min-width: 60px;\r\n        margin-left: 0;\r\n    }\r\n\r\n    .lettered-item {\r\n        display: flex;\r\n        align-items: flex-start;\r\n        margin-bottom: 6px;\r\n        font-size: 9pt;\r\n        padding-left: 20px;\r\n    }\r\n\r\n    .lettered-item .ltr {\r\n        min-width: 24px;\r\n    }\r\n\r\n    .lettered-item .content {\r\n        flex: 1;\r\n        display: flex;\r\n        align-items: flex-end;\r\n        flex-wrap: wrap;\r\n        gap: 4px;\r\n    }\r\n\r\n    /* .full lines already stretch to 98% width on their own row,\r\n       so only non-full dotted-lines need the flex-grow treatment */\r\n    .lettered-item .content > .dotted-line:not(.full) {\r\n        flex: 1;\r\n        min-width: 60px;\r\n        margin-left: 0;\r\n    }\r\n\r\n    .general-info-item {\r\n        font-size: 9pt;\r\n        margin-bottom: 4px;\r\n        line-height: 1.5;\r\n        display: flex;\r\n        align-items: flex-end;\r\n        flex-wrap: wrap;\r\n        gap: 4px;\r\n    }\r\n\r\n    .general-info-item > .dotted-line {\r\n        flex: 1;\r\n        min-width: 60px;\r\n        margin-left: 0;\r\n    }\r\n\r\n    .declaration {\r\n        margin: 14px 0 10px 0;\r\n        font-size: 9pt;\r\n        line-height: 1.7;\r\n        text-align: justify;\r\n        padding: 4px 0;\r\n    }\r\n\r\n    .signature-section {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-top: 20px;\r\n        margin-bottom: 14px;\r\n    }\r\n\r\n    .signature-section td {\r\n        padding: 0 4px;\r\n        vertical-align: bottom;\r\n        border: none;\r\n        font-size: 9pt;\r\n    }\r\n\r\n    .signature-section .field-row {\r\n        display: flex;\r\n        align-items: flex-end;\r\n        gap: 4px;\r\n    }\r\n\r\n    .signature-section .field-row .dotted-line {\r\n        flex: 1;\r\n        min-width: 60px;\r\n        margin-left: 0;\r\n    }\r\n\r\n    .signature-line {\r\n        border-top: 1px solid #000;\r\n        padding-top: 4px;\r\n        font-size: 8.5pt;\r\n        margin-top: 40px;\r\n    }\r\n\r\n    .total-amount-row {\r\n        margin: 10px 0;\r\n        font-size: 9pt;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .practitioner-section {\r\n        margin-top: 14px;\r\n    }\r\n\r\n    .practitioner-section .section-header {\r\n        font-size: 9pt;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        margin-bottom: 10px;\r\n    }\r\n\r\n    .practitioner-footer {\r\n        margin-top: 14px;\r\n        font-size: 9pt;\r\n        line-height: 1.7;\r\n    }\r\n\r\n    .practitioner-footer .sig-right {\r\n        text-align: right;\r\n        font-size: 9pt;\r\n        font-weight: bold;\r\n        margin: 16px 0 30px 0;\r\n    }\r\n\r\n    .print-meta {\r\n        font-size: 8pt;\r\n        color: #000;\r\n        text-align: right;\r\n        margin-bottom: 6px;\r\n    }\r\n\r\n    .italic-note {\r\n        font-style: italic;\r\n        font-size: 8.5pt;\r\n    }\r\n\r\n    .period-row {\r\n        display: flex;\r\n        gap: 40px;\r\n        font-size: 9pt;\r\n        margin-bottom: 8px;\r\n    }\r\n\r\n    /* Period of hospitalization fields, right-aligned dotted lines */\r\n    .period-fields {\r\n        display: flex;\r\n        gap: 20px;\r\n        flex-wrap: wrap;\r\n        padding-left: 20px;\r\n        margin-bottom: 8px;\r\n        font-size: 9pt;\r\n    }\r\n\r\n    .period-fields .sub-field {\r\n        display: flex;\r\n        align-items: flex-end;\r\n        flex: 1;\r\n        gap: 4px;\r\n    }\r\n\r\n    .period-fields .sub-field .dotted-line {\r\n        flex: 1;\r\n        min-width: 60px;\r\n        margin-left: 0;\r\n    }\r\n\r\n    hr.divider {\r\n        border: none;\r\n        border-top: 1px solid #000;\r\n        margin: 12px 0;\r\n    }\r\n\r\n    @media print {\r\n        @page {\r\n            size: A4 portrait;\r\n            margin: 15mm 15mm 15mm 15mm;\r\n        }\r\n\r\n        body {\r\n            padding: 0;\r\n        }\r\n\r\n        * {\r\n            -webkit-print-color-adjust: exact;\r\n            print-color-adjust: exact;\r\n        }\r\n    }\r\n</style>\r\n\r\n\r\n\r\n<!-- HEADER -->\r\n<div class=\"form-title\" style=\"position: relative;\">\r\n    <h4>University of Colombo School of Computing</h4>\r\n    <h4>Staff Medical Support Scheme \u2013 2026</h4>\r\n    <h4 class=\"italic\">Surgical and Hospital Expenses Claim Form</h4>\r\n</div>\r\n\r\n{% set ins_mem = frappe.get_doc(\"Insurance Member\", doc.employee) %}\r\n{% set emp = frappe.get_doc(\"Employee\", ins_mem.employee) %}\r\n{% set emp_scheme = frappe.get_doc(\"Support Scheme\", ins_mem.insurance_scheme) %}\r\n\r\n<!-- TOP ROW: EMP No, Scheme checkboxes, S.No -->\r\n<table class=\"employee-section\">\r\n    <tr>\r\n        <td colspan=\"3\"></td>\r\n        <td style=\"text-align: right\">\r\n            Claim No:\r\n            <span class=\"line\">{{ doc.name }}</span>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<table class=\"employee-section\">\r\n    <tr>\r\n        <td>\r\n            EMP. No:\r\n            <span class=\"line\">{{ ins_mem.employee }}</span>\r\n        </td>\r\n        <td>\r\n            Scheme I\r\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme I\" %}\u2713{% endif %}</span>\r\n        </td>\r\n        <td>\r\n            Scheme II\r\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme II\" %}\u2713{% endif %}</span>\r\n        </td>\r\n        <td>\r\n            Scheme III\r\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme III\" %}\u2713{% endif %}</span>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<!-- EMPLOYEE'S SECTION -->\r\n<div class=\"section-title\">Employee Details</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">1.</span>\r\n    <span class=\"content\">\r\n        Name :\r\n        <span>{{ emp.salutation }} {{ ins_mem.employee_name }}</span>\r\n    </span>\r\n</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">2.</span>\r\n    <span class=\"content\">\r\n        Designation :\r\n        <span>{{ emp.designation or '' }}</span>\r\n    </span>\r\n</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">3.</span>\r\n    <span class=\"content\">\r\n        Employee Category :\r\n        <span>{{ emp.employee_category or '' }}</span>\r\n    </span>\r\n</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">4.</span>\r\n    <span class=\"content\" style=\"display:flex; gap:20px;\">\r\n        {% if emp.department %}\r\n            <span>Department : <span>{{ emp.department }}</span></span>\r\n        {% endif %}\r\n        \r\n        {% if emp.branch %}\r\n            <span>Division : <span>{{ emp.branch }}</span></span>\r\n        {% endif %}\r\n        <!--<span>Age: <span class=\"dotted-line short\"></span></span>-->\r\n    </span>\r\n</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">5.</span>\r\n    <span class=\"content\">\r\n        Address :\r\n        <span>{{ emp.permanent_address or '' }}</span>\r\n    </span>\r\n</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">6.</span>\r\n    <span class=\"content\" style=\"display:flex; gap:10px; flex-wrap:wrap;\">\r\n        <span>Telephone No : <span>{{ emp.cell_number or '' }}</span></span>\r\n        \r\n    </span>\r\n</div>\r\n\r\n{% if doc.dependent_name %}\r\n    <!-- DEPENDANT SECTION -->\r\n    <div class=\"section-title\">Dependant \u2013 <span style=\"font-weight:normal; text-transform:none;\">(Subject in respect of whom claim is made)</span></div>\r\n    \r\n    <div class=\"numbered-item\">\r\n        <span class=\"num\">1.</span>\r\n        <span class=\"content\">\r\n            Name :\r\n            <span>{{ doc.dependent_name.split('(')[0].rstrip() or '' }}</span>\r\n        </span>\r\n    </div>\r\n    \r\n    <div class=\"numbered-item\">\r\n        <span class=\"num\">2.</span>\r\n        <span class=\"content\">\r\n            Relationship:\r\n            <span>{{ doc.dependent_name.split('(')[1].split(')')[0] or '' }}</span>\r\n        </span>\r\n    </div>\r\n{% endif %}\r\n\r\n\r\n<!-- INJURY SECTION -->\r\n<div class=\"section-title\">Injury \u2013 <span style=\"font-weight:normal; text-transform:none;\">please state</span></div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">1.</span>\r\n    <span class=\"content\">\r\n        Date and place of Accident:\r\n        <span class=\"dotted-line long\">{{ doc.date_of_accident or '' }} {{ doc.place_of_accident or '' }}</span>\r\n    </span>\r\n</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">2.</span>\r\n    <span class=\"content\">\r\n        Precisely how the Accident occurred:\r\n        <span class=\"dotted-line long\">{{ doc.precisely_how_the_accident_occurred or '' }}</span>\r\n    </span>\r\n</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">3.</span>\r\n    <span class=\"content\">\r\n        Nature and Extent of Injuries:\r\n        <span class=\"dotted-line long\">{{ doc.nature_and_extent_of_injuries or '' }}</span>\r\n    </span>\r\n</div>\r\n\r\n<!-- ILLNESS SECTION -->\r\n<div class=\"section-title\">Illness \u2013 <span style=\"font-weight:normal; text-transform:none;\">please state</span></div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">1.</span>\r\n    <span class=\"content\">\r\n        Nature of Description of illness:\r\n        <span class=\"dotted-line long\">{{ doc.nature_of_description_of_illness or '' }}</span>\r\n    </span>\r\n</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">2.</span>\r\n    <span class=\"content\">\r\n        Date of Commencement of illness:\r\n        <span class=\"dotted-line medium\">{{ doc.date_of_commencement_of_illness or '' }}</span>\r\n    </span>\r\n</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">3.</span>\r\n    <span class=\"content\">\r\n        Date of first consultation regarding this illness:\r\n        <span class=\"dotted-line medium\">{{ doc.date_of_first_consultation_regarding_this_illness or '' }}</span>\r\n    </span>\r\n</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">4.</span>\r\n    <span class=\"content\">\r\n        Name &amp; the address of doctor who was first consulted:\r\n        <span class=\"dotted-line long\">{{ doc.name_and_the_address_of_doctor_who_was_first_consulted or '' }}</span>\r\n    </span>\r\n</div>\r\n\r\n<!-- PERIOD OF HOSPITALIZATION -->\r\n<div class=\"section-title\">Period of Hospitalization</div>\r\n<div class=\"period-fields\">\r\n    <span class=\"sub-field\">\r\n        From: <span class=\"dotted-line medium\">{{ doc.from or '' }}</span>\r\n    </span>\r\n    <span class=\"sub-field\">\r\n        To: <span class=\"dotted-line medium\">{{ doc.to or '' }}</span>\r\n    </span>\r\n</div>\r\n\r\n<!-- GENERAL INFORMATION -->\r\n<div class=\"section-title\">General Information</div>\r\n\r\n<div class=\"general-info-item\">Have you ever had the same illness before?\r\n    <span class=\"dotted-line long\">{{ \"Yes\" if doc.checkbox_1 else \"No\" }}</span></div>\r\n\r\n{% if doc.checkbox_1 %}    \r\n    <div class=\"general-info-item\">If so, give the particulars and date\r\n        <span class=\"dotted-line long\">{{ doc.previous_illness or '' }}</span>\r\n    </div>\r\n{% endif %}\r\n\r\n<div class=\"general-info-item\">Have you during the past five years had any illness or accident necessitating medical attention?\r\n    <span class=\"dotted-line long\">{{ \"Yes\" if doc.checkbox_2 else \"No\" }}</span></div>\r\n    \r\n{% if doc.checkbox_2 %}    \r\n    <div class=\"general-info-item\">If so, give full particulars\r\n        <span class=\"dotted-line long\">{{ doc.past_illness or '' }}</span>\r\n    </div>\r\n{% endif %}\r\n\r\n<div class=\"general-info-item\">Have you previously suffered from sickness accident injury, which has given rise to a claim to any insurance company or upon any benefit/society Fund?\r\n    <span class=\"dotted-line long\">{{ \"Yes\" if doc.checkbox_3 else \"No\" }}</span></div>\r\n\r\n{% if doc.checkbox_3 %}      \r\n    <div class=\"general-info-item\">If so, give full particulars\r\n        <span class=\"dotted-line long\">{{ doc.previous_insurance_claim or '' }}</span>\r\n    </div>\r\n{% endif %}\r\n\r\n<div class=\"general-info-item\">Any claims pending or are you entitled to claim upon any other insurer, Society of fund in respect of any illness or any injury suffered by you?\r\n    <span class=\"dotted-line long\">{{ \"Yes\" if doc.checkbox_4 else \"No\" }}</span></div>\r\n    \r\n<div class=\"general-info-item\">If you are undergoing treatment for the injury or illness to which this claim relates, please state?\r\n    <span class=\"dotted-line long\">{{ \"Yes\" if doc.checkbox_6 else \"No\" }}</span></div>\r\n\r\n{% if doc.checkbox_6 %}\r\n    <div class=\"lettered-item\">\r\n        <span class=\"ltr\">a.</span>\r\n        <span class=\"content\">Nature of illness\r\n            <span class=\"dotted-line long\">{{ doc.nature_of_illness or '' }}</span>\r\n        </span>\r\n    </div>\r\n    \r\n    <div class=\"lettered-item\">\r\n        <span class=\"ltr\">b.</span>\r\n        <span class=\"content\">Nature of treatment\r\n            <span class=\"dotted-line long\">{{ doc.nature_of_treatment or '' }}</span>\r\n        </span>\r\n    </div>\r\n    \r\n    <div class=\"lettered-item\">\r\n        <span class=\"ltr\">c.</span>\r\n        <span class=\"content\">Name of hospital concerned if any\r\n            <span class=\"dotted-line long\">{{ doc.name_of_hospital_concerned_if_any or '' }}</span>\r\n        </span>\r\n    </div>\r\n    \r\n    <div class=\"lettered-item\">\r\n        <span class=\"ltr\">d.</span>\r\n        <span class=\"content\">Name of any Consulting Specialists Whose recommended treatment you or have been receiving giving details of the treatment concerned and other Specialist services received.\r\n           <br><br><span class=\"dotted-line full\">{{ doc.other_details or '' }}</span>\r\n        </span>\r\n    </div>\r\n{% endif %}\r\n\r\n<!-- DECLARATION -->\r\n<div class=\"declaration\">\r\n    I HEREBY DECLARE that I have received the injuries above described and suffering from illness as above described, and I claim reimbursement under the above Medical Welfare Scheme in respect thereof I hereby warrant that the above statements and facts are true and that I have not withheld from the University any material information connected with this claim.\r\n</div>\r\n\r\n<!-- APPLICANT SIGNATURE -->\r\n<!--<table class=\"signature-section\">-->\r\n<!--    <tr>-->\r\n<!--        <td style=\"padding-top:10px;\">-->\r\n<!--            <span class=\"field-row\">Date: <span>{{ frappe.utils.today() }}</span></span>-->\r\n<!--        </td>-->\r\n<!--        <td></td>-->\r\n<!--        <td style=\"width:50%\">-->\r\n<!--            <span class=\"field-row\">Applicant (Signature): <span class=\"dotted-line medium\"></span></span>-->\r\n<!--        </td>-->\r\n<!--        <td style=\"width:50%\"></td>-->\r\n        \r\n        \r\n<!--    </tr>-->\r\n<!--</table>-->\r\n\r\n<table style=\"margin-top:16px; margin-bottom:0;\">\r\n    <tr>\r\n        <td style=\"width:70%; vertical-align:top;\">\r\n            Date: <span>{{ frappe.utils.today() }}</span></span>\r\n           \r\n        </td>\r\n        <td style=\"width:30%; text-align:right; vertical-align:bottom;\">\r\n            <div style=\"margin-top:20px; border-top:1px dotted #000; padding-top:4px;\"></div>\r\n            <div style=\"font-weight:bold; font-size:10pt;  text-align:center;\">\r\n                Applicant (Signature)\r\n            </div>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<!-- TOTAL AMOUNT -->\r\n<div class=\"total-amount-row\" style=\"margin-top:16px;\">\r\n    Total Amount of all receipts (bills): Rs.&nbsp;\r\n    <span style=\"border-bottom:1px dotted #000; padding:0 6px;\">\r\n        {{ \"{:,.2f}\".format(doc.amount or 0) }}\r\n    </span>\r\n</div>",
