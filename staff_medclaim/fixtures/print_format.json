  "doc_type": "Insurance Claim",
  "docstatus": 0,
  "doctype": "Print Format",
  "font": null,
  "font_size": 14,
  "format_data": null,
  "html": "<!-- Insurance Claim - Surgical & Hospital -->\n\n<!-- PRINT STYLES -->\n<style>\n    @media print { tr, .checkbox { page-break-inside: avoid; } thead { display: table-header-group; } }\n    * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n        color: #000 !important;\n        background: #fff !important;\n        font-family: Arial, sans-serif;\n        font-size: 10pt;\n    }\n\n    body {\n        width: 100%;\n        \n    }\n    \n    .form-title{\n        text-align: center;\n    }\n\n    .form-title h4.italic {\n        font-style: italic;\n    }\n\n    table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 6px;\n    }\n\n    table.top-row td {\n        padding: 3px 3px;\n        font-size: 10pt;\n        vertical-align: middle;\n        border: none;\n    }\n    \n    table.employee-section td {\n        padding: 4px 2px;\n        font-size: 10pt;\n        vertical-align: middle;\n        border: none;\n        line-height: 0.5;\n    }\n\n    .section-title {\n        font-size: 10pt;\n        font-weight: bold;\n        margin: 10px 0 4px 0;\n        text-transform: uppercase;\n    }\n\n    .dotted-line {\n        border-bottom: 1px dotted #000;\n        display: inline-block;\n        min-width: 200px;\n        margin-left: 4px;\n        vertical-align: bottom;\n        /*background-size: 8px 1px;*/\n    }\n\n    .dotted-line.short {\n        min-width: 80px;\n    }\n\n    .dotted-line.medium {\n        min-width: 140px;\n    }\n\n    .dotted-line.long {\n        min-width: 300px;\n    }\n\n    .dotted-line.full {\n        min-width: 98%;\n        display: block;\n        margin-top: 2px;\n    }\n\n    .checkbox {\n        display: inline-block;\n        width: 16px;\n        height: 16px;\n        border: 1px solid #000;\n        text-align: center;\n        line-height: 14px;\n        font-size: 12pt;\n        margin-left: 4px;\n        margin-top: -10px;\n        vertical-align: middle;\n    }\n\n    .numbered-item {\n        display: flex;\n        align-items: flex-start;\n        margin-bottom: 6px;\n        font-size: 10pt;\n    }\n\n    .numbered-item .num {\n        min-width: 20px;\n        font-weight: normal;\n    }\n\n    .numbered-item .content {\n        flex: 1;\n    }\n\n    .lettered-item {\n        display: flex;\n        align-items: flex-start;\n        margin-bottom: 15px;\n        font-size: 10pt;\n        padding-left: 20px;\n    }\n\n    .lettered-item .ltr {\n        min-width: 24px;\n    }\n\n    /* Content is now a flex row so the dotted line can grow to fill\n       remaining space, making all lines end at the same right edge */\n    .lettered-item .content {\n        flex: 1;\n        display: flex;\n        align-items: flex-end;\n        flex-wrap: nowrap;\n    }\n\n    .lettered-item .content > .label-text {\n        white-space: normal;\n    }\n\n    .lettered-item .content > .dotted-line {\n        flex: 1;\n        min-width: 0;\n        margin-left: 4px;\n    }\n\n    /* Sub-rows inside item h (admission / discharge dates) */\n    .sub-row {\n        display: flex;\n        gap: 20px;\n        margin-top: 6px;\n        width: 100%;\n    }\n\n    .sub-row .sub-field {\n        display: flex;\n        flex: 1;\n        align-items: flex-end;\n    }\n\n    .sub-row .sub-field .dotted-line {\n        flex: 1;\n        min-width: 0;\n        margin-left: 4px;\n    }\n\n    .general-info-item {\n        font-size: 10pt;\n        margin-bottom: 4px;\n        line-height: 1.5;\n    }\n\n    .declaration {\n        margin: 14px 0 10px 0;\n        font-size: 10pt;\n        line-height: 1.7;\n        text-align: justify;\n        padding: 4px 0;\n    }\n\n    .signature-section {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 20px;\n        margin-bottom: 14px;\n    }\n\n    .signature-section td {\n        padding: 0 4px;\n        vertical-align: bottom;\n        border: none;\n        font-size: 9pt;\n    }\n\n    .signature-line {\n        border-top: 1px solid #000;\n        padding-top: 4px;\n        font-size: 8.5pt;\n        margin-top: 40px;\n    }\n\n    .total-amount-row {\n        margin: 10px 0;\n        font-size: 10pt;\n        font-weight: bold;\n    }\n\n    .practitioner-section {\n        margin-top: 14px;\n    }\n\n    .practitioner-section .section-header {\n        font-size: 10pt;\n        font-weight: bold;\n        text-transform: uppercase;\n        margin-bottom: 10px;\n    }\n\n    .practitioner-footer {\n        margin-top: 14px;\n        font-size: 9pt;\n        line-height: 1.7;\n    }\n\n    .practitioner-footer .sig-right {\n        text-align: right;\n        font-size: 10pt;\n        font-weight: bold;\n        margin: 16px 0 30px 0;\n    }\n\n    .print-meta {\n        font-size: 8pt;\n        color: #000;\n        text-align: right;\n        margin-bottom: 6px;\n    }\n\n    .italic-note {\n        font-style: italic;\n        font-size: 8.5pt;\n    }\n\n    .period-row {\n        display: flex;\n        gap: 40px;\n        font-size: 9pt;\n        margin-bottom: 8px;\n    }\n\n    hr.divider {\n        border: none;\n        border-top: 1px solid #000;\n        margin: 12px 0;\n    }\n\n    @media print {\n        @page {\n            size: A4 portrait;\n            margin: 15mm 15mm 15mm 15mm;\n        }\n\n        body {\n            padding: 0;\n        }\n\n        * {\n            -webkit-print-color-adjust: exact;\n            print-color-adjust: exact;\n        }\n    }\n</style>\n\n\n\n<!-- HEADER -->\n<div class=\"form-title\" style=\"position: relative;\">\n        <div style=\"position: absolute; top: 0; right: 0; font-style: normal; font-weight: bold;\">\n            Doctor Recomandation\n        </div>\n        <h4>University of Colombo School of Computing</h4>\n        <h4>Staff Medical Support Scheme – {{ (frappe.db.get_value(\"Insurance Period\", doc.insurance_period, \"year\") if doc.insurance_period else None) or frappe.utils.getdate(doc.creation).year }}</h4>\n        <h4 class=\"italic\">Surgical and Hospital Expenses Claim Form</h4>\n    </div>\n\n{% set ins_mem = frappe.get_doc(\"Insurance Member\", doc.employee) %}\n{% set emp = frappe.get_doc(\"Employee\", ins_mem.employee) %}\n{% set emp_scheme = frappe.get_doc(\"Support Scheme\", ins_mem.insurance_scheme) %}\n\n<!-- TOP ROW: EMP No, Scheme checkboxes, S.No -->\n<table class=\"employee-section\">\n    <tr>\n        <td colspan=\"3\"></td>\n        <td style=\"text-align: right\">\n            Claim No:\n            <span class=\"line\">{{ doc.name }}</span>\n        </td>\n    </tr>\n</table>\n\n<table class=\"employee-section\">\n    <tr>\n        <td>\n            EMP. No:\n            <span class=\"line\">{{ ins_mem.employee }}</span>\n        </td>\n        <td>\n            Scheme I\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme I\" %}✓{% endif %}</span>\n        </td>\n        <td>\n            Scheme II\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme II\" %}✓{% endif %}</span>\n        </td>\n        <td>\n            Scheme III\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme III\" %}✓{% endif %}</span>\n        </td>\n    </tr>\n</table>\n\n<!-- EMPLOYEE'S SECTION -->\n<div class=\"section-title\">Employee Details</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">1.</span>\n    <span class=\"content\">\n        Name :\n        <span>{{ emp.salutation }} {{ ins_mem.employee_name }}</span>\n    </span>\n</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">2.</span>\n    <span class=\"content\">\n        Designation :\n        <span>{{ emp.designation or '' }}</span>\n    </span>\n</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">3.</span>\n    <span class=\"content\">\n        Employee Category :\n        <span>{{ emp.employee_category or '' }}</span>\n    </span>\n</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">4.</span>\n    <span class=\"content\" style=\"display:flex; gap:20px;\">\n        {% if emp.department %}\n            <span>Department : <span>{{ emp.department }}</span></span>\n        {% endif %}\n        \n        {% if emp.branch %}\n            <span>Division : <span>{{ emp.branch }}</span></span>\n        {% endif %}\n        <!--<span>Age: <span class=\"dotted-line short\"></span></span>-->\n    </span>\n</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">5.</span>\n    <span class=\"content\">\n        Address :\n        <span>{{ emp.permanent_address or '' }}</span>\n    </span>\n</div>\n\n<div class=\"numbered-item\">\n    <span class=\"num\">6.</span>\n    <span class=\"content\" style=\"display:flex; gap:10px; flex-wrap:wrap;\">\n        <span>Telephone No : <span>{{ emp.cell_number or '' }}</span></span>\n        \n    </span>\n</div>\n\n{% if doc.dependent_name %}\n    <!-- DEPENDANT SECTION -->\n    <div class=\"section-title\">Dependant – <span style=\"font-weight:normal; text-transform:none;\">(Subject in respect of whom claim is made)</span></div>\n    \n    <div class=\"numbered-item\">\n        <span class=\"num\">1.</span>\n        <span class=\"content\">\n            Name (in full):\n            <span>{{ doc.dependent_name.split('(')[0].rstrip() or '' }}</span>\n        </span>\n    </div>\n    \n    <div class=\"numbered-item\">\n        <span class=\"num\">2.</span>\n        <span class=\"content\">\n            Relationship:\n            <span>{{ doc.dependent_name.split('(')[1].split(')')[0] or '' }}</span>\n        </span>\n    </div>\n{% endif %}\n\n<hr class=\"divider\">\n\n<!-- PRACTITIONER / SURGEON SECTION -->\n<div class=\"practitioner-section\">\n    <div class=\"section-header\">To Be Completed by the Patient's/ General Practitioner/ Surgeon</div>\n\n    <div class=\"lettered-item\">\n        <span class=\"ltr\">a.</span>\n        <span class=\"content\">\n            <span class=\"label-text\">Name of patient :</span>\n            <span class=\"dotted-line\"></span>\n        </span>\n    </div>\n\n    <div class=\"lettered-item\">\n        <span class=\"ltr\">b.</span>\n        <span class=\"content\">\n            <span class=\"label-text\">Condition that necessitated investigation or treatment :</span>\n            <span class=\"dotted-line\"></span>\n        </span>\n    </div>\n\n    <div class=\"lettered-item\">\n        <span class=\"ltr\">c.</span>\n        <span class=\"content\">\n            <span class=\"label-text\">General practitioner by whom referred :</span>\n            <span class=\"dotted-line\"></span>\n        </span>\n    </div>\n\n    <div class=\"lettered-item\">\n        <span class=\"ltr\">d.</span>\n        <span class=\"content\">\n            <span class=\"label-text\">Diagnosis of disease :</span>\n            <span class=\"dotted-line\"></span>\n        </span>\n    </div>\n\n    <div class=\"lettered-item\">\n        <span class=\"ltr\">e.</span>\n        <span class=\"content\">\n            <span class=\"label-text\">Details of treatment or operation and prognosis :</span>\n            <span class=\"dotted-line\"></span>\n        </span>\n    </div>\n\n    <div class=\"lettered-item\">\n        <span class=\"ltr\">f.</span>\n        <span class=\"content\">\n            <span class=\"label-text\">Was the onset of illness acute, sub-acute or chronic?</span>\n            <span class=\"dotted-line\"></span>\n        </span>\n    </div>\n\n    <div class=\"lettered-item\">\n        <span class=\"ltr\">g.</span>\n        <span class=\"content\">\n            <span class=\"label-text\">For how long would the patient have suffered from these symptoms and signs?</span>\n            <span class=\"dotted-line\"></span>\n        </span>\n    </div>\n\n    <div class=\"lettered-item\">\n        <span class=\"ltr\">h.</span>\n        <span class=\"content\" style=\"display:block;\">\n            <span style=\"display:flex; align-items:flex-end; width:100%;\">\n                <span class=\"label-text\">Period of hospitalization :</span>\n                <span class=\"dotted-line\" style=\"flex:1; min-width:0; margin-left:4px;\"></span>\n            </span>\n        </span>\n    </div>\n    \n    <div class=\"lettered-item\">\n        <span class=\"ltr\"></span>\n            <span class=\"sub-row\">\n                <span class=\"sub-field\">\n                    <span class=\"label-text\">Date of admission :</span>\n                    <span class=\"dotted-line\"></span>\n                </span>\n                <span class=\"sub-field\">\n                    <span class=\"label-text\">Date of Discharge :</span>\n                    <span class=\"dotted-line\"></span>\n                </span>\n            </span>\n        </span>\n    </div>        \n\n    <div class=\"lettered-item\">\n        <span class=\"ltr\">i.</span>\n        <span class=\"content\" style=\"display:block;\">\n            <span style=\"display:flex; align-items:flex-end; width:100%;\">\n                <span class=\"label-text\">State approximately when, in your opinion the ailment could have BEGUN or been CONTRACTED by the patient :</span>\n                <span class=\"dotted-line\" style=\"flex:1; min-width:0; margin-left:4px;\"></span>\n            </span>\n            <span class=\"dotted-line full\" style=\"margin-top:16px;\"></span>\n        </span>\n    </div>\n\n    <!-- Practitioner Declaration -->\n    <div class=\"practitioner-footer\">\n        <p style=\"font-size:10pt; line-height:1.7;\">\n            I certify that I am the General Practitioner/ Surgeon of the patient of the referred to above, and that I approved the services for which this claim is made.\n        </p>\n\n        <table style=\"margin-top:16px; margin-bottom:0;\">\n            <tr>\n                <td style=\"width:50%; vertical-align:top;\">\n                    Date: <span class=\"dotted-line medium\"></span>\n                   \n                </td>\n                <td style=\"width:50%; text-align:right; vertical-align:bottom;\">\n                    <div style=\"margin-top:10px; border-top:1px solid #000; padding-top:4px;\"></div>\n                    <div style=\"font-weight:bold; font-size:10pt; \">\n                        Signature of the Practitioner/ Surgeon/<br>\n                        Specialist who attended on this patient for this ailment\n                    </div>\n                </td>\n            </tr>\n        </table>\n\n        <div style=\"margin-top:14px; font-size:10pt;\">\n            <div style=\"margin-bottom:10px;\">\n                Name of Practitioner/ Surgeon : <span class=\"dotted-line long\"></span></span></span>\n            </div>\n            <div style=\"margin-bottom:10px;\">\n                Qualifications : <span class=\"dotted-line long\"></span>\n            </div>\n            <div style=\"margin-bottom:10px;\">\n                Address : <span class=\"dotted-line long\"></span>\n            </div>\n            <div style=\"margin-bottom:10px;\">\n                T.Phone No. : <span class=\"dotted-line long\"></span>\n            </div>\n        </div>\n\n        <div class=\"italic-note\" style=\"margin-top:8px;\">\n            (To be completed by surgeon all cases as surgical and surgical treatment)\n        </div>\n    </div>\n</div>\n",
