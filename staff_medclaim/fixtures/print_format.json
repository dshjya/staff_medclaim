  "font_size": 14,
  "format_data": null,
  "html": "<!-- Insurance Claim - Surgical & Hospital -->\r\n\r\n<!-- PRINT STYLES -->\r\n<style>\r\n    * {\r\n        margin: 0;\r\n        padding: 0;\r\n        box-sizing: border-box;\r\n        color: #000 !important;\r\n        background: #fff !important;\r\n        font-family: Arial, sans-serif;\r\n        font-size: 10pt;\r\n    }\r\n\r\n    body {\r\n        width: 100%;\r\n        \r\n    }\r\n    \r\n    .form-title{\r\n        text-align: center;\r\n    }\r\n\r\n    .form-title h4.italic {\r\n        font-style: italic;\r\n    }\r\n\r\n    table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-bottom: 6px;\r\n    }\r\n\r\n    table.top-row td {\r\n        padding: 3px 3px;\r\n        font-size: 10pt;\r\n        vertical-align: middle;\r\n        border: none;\r\n    }\r\n    \r\n    table.employee-section td {\r\n        padding: 4px 2px;\r\n        font-size: 10pt;\r\n        vertical-align: middle;\r\n        border: none;\r\n        line-height: 0.5;\r\n    }\r\n\r\n    .section-title {\r\n        font-size: 10pt;\r\n        font-weight: bold;\r\n        margin: 10px 0 4px 0;\r\n        text-transform: uppercase;\r\n    }\r\n\r\n    .dotted-line {\r\n        border-bottom: 1px dotted #000;\r\n        display: inline-block;\r\n        min-width: 200px;\r\n        margin-left: 4px;\r\n        vertical-align: bottom;\r\n        /*background-size: 8px 1px;*/\r\n    }\r\n\r\n    .dotted-line.short {\r\n        min-width: 80px;\r\n    }\r\n\r\n    .dotted-line.medium {\r\n        min-width: 140px;\r\n    }\r\n\r\n    .dotted-line.long {\r\n        min-width: 300px;\r\n    }\r\n\r\n    .dotted-line.full {\r\n        min-width: 98%;\r\n        display: block;\r\n        margin-top: 2px;\r\n    }\r\n\r\n    .checkbox {\r\n        display: inline-block;\r\n        width: 16px;\r\n        height: 16px;\r\n        border: 1px solid #000;\r\n        text-align: center;\r\n        line-height: 14px;\r\n        font-size: 12pt;\r\n        margin-left: 4px;\r\n        margin-top: -10px;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    .numbered-item {\r\n        display: flex;\r\n        align-items: flex-start;\r\n        margin-bottom: 6px;\r\n        font-size: 10pt;\r\n    }\r\n\r\n    .numbered-item .num {\r\n        min-width: 20px;\r\n        font-weight: normal;\r\n    }\r\n\r\n    .numbered-item .content {\r\n        flex: 1;\r\n    }\r\n\r\n    .lettered-item {\r\n        display: flex;\r\n        align-items: flex-start;\r\n        margin-bottom: 15px;\r\n        font-size: 10pt;\r\n        padding-left: 20px;\r\n    }\r\n\r\n    .lettered-item .ltr {\r\n        min-width: 24px;\r\n    }\r\n\r\n    /* Content is now a flex row so the dotted line can grow to fill\r\n       remaining space, making all lines end at the same right edge */\r\n    .lettered-item .content {\r\n        flex: 1;\r\n        display: flex;\r\n        align-items: flex-end;\r\n        flex-wrap: nowrap;\r\n    }\r\n\r\n    .lettered-item .content > .label-text {\r\n        white-space: normal;\r\n    }\r\n\r\n    .lettered-item .content > .dotted-line {\r\n        flex: 1;\r\n        min-width: 0;\r\n        margin-left: 4px;\r\n    }\r\n\r\n    /* Sub-rows inside item h (admission / discharge dates) */\r\n    .sub-row {\r\n        display: flex;\r\n        gap: 20px;\r\n        margin-top: 6px;\r\n        width: 100%;\r\n    }\r\n\r\n    .sub-row .sub-field {\r\n        display: flex;\r\n        flex: 1;\r\n        align-items: flex-end;\r\n    }\r\n\r\n    .sub-row .sub-field .dotted-line {\r\n        flex: 1;\r\n        min-width: 0;\r\n        margin-left: 4px;\r\n    }\r\n\r\n    .general-info-item {\r\n        font-size: 10pt;\r\n        margin-bottom: 4px;\r\n        line-height: 1.5;\r\n    }\r\n\r\n    .declaration {\r\n        margin: 14px 0 10px 0;\r\n        font-size: 10pt;\r\n        line-height: 1.7;\r\n        text-align: justify;\r\n        padding: 4px 0;\r\n    }\r\n\r\n    .signature-section {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n        margin-top: 20px;\r\n        margin-bottom: 14px;\r\n    }\r\n\r\n    .signature-section td {\r\n        padding: 0 4px;\r\n        vertical-align: bottom;\r\n        border: none;\r\n        font-size: 9pt;\r\n    }\r\n\r\n    .signature-line {\r\n        border-top: 1px solid #000;\r\n        padding-top: 4px;\r\n        font-size: 8.5pt;\r\n        margin-top: 40px;\r\n    }\r\n\r\n    .total-amount-row {\r\n        margin: 10px 0;\r\n        font-size: 10pt;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .practitioner-section {\r\n        margin-top: 14px;\r\n    }\r\n\r\n    .practitioner-section .section-header {\r\n        font-size: 10pt;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n        margin-bottom: 10px;\r\n    }\r\n\r\n    .practitioner-footer {\r\n        margin-top: 14px;\r\n        font-size: 9pt;\r\n        line-height: 1.7;\r\n    }\r\n\r\n    .practitioner-footer .sig-right {\r\n        text-align: right;\r\n        font-size: 10pt;\r\n        font-weight: bold;\r\n        margin: 16px 0 30px 0;\r\n    }\r\n\r\n    .print-meta {\r\n        font-size: 8pt;\r\n        color: #000;\r\n        text-align: right;\r\n        margin-bottom: 6px;\r\n    }\r\n\r\n    .italic-note {\r\n        font-style: italic;\r\n        font-size: 8.5pt;\r\n    }\r\n\r\n    .period-row {\r\n        display: flex;\r\n        gap: 40px;\r\n        font-size: 9pt;\r\n        margin-bottom: 8px;\r\n    }\r\n\r\n    hr.divider {\r\n        border: none;\r\n        border-top: 1px solid #000;\r\n        margin: 12px 0;\r\n    }\r\n\r\n    @media print {\r\n        @page {\r\n            size: A4 portrait;\r\n            margin: 15mm 15mm 15mm 15mm;\r\n        }\r\n\r\n        body {\r\n            padding: 0;\r\n        }\r\n\r\n        * {\r\n            -webkit-print-color-adjust: exact;\r\n            print-color-adjust: exact;\r\n        }\r\n    }\r\n</style>\r\n\r\n\r\n\r\n<!-- HEADER -->\r\n<div class=\"form-title\" style=\"position: relative;\">\r\n        <div style=\"position: absolute; top: 0; right: 0; font-style: normal; font-weight: bold;\">\r\n            Doctor Recomandation\r\n        </div>\r\n        <h4>University of Colombo School of Computing</h4>\r\n        <h4>Staff Medical Support Scheme \u2013 2026</h4>\r\n        <h4 class=\"italic\">Surgical and Hospital Expenses Claim Form</h4>\r\n    </div>\r\n\r\n{% set ins_mem = frappe.get_doc(\"Insurance Member\", doc.employee) %}\r\n{% set emp = frappe.get_doc(\"Employee\", ins_mem.employee) %}\r\n{% set emp_scheme = frappe.get_doc(\"Support Scheme\", ins_mem.insurance_scheme) %}\r\n\r\n<!-- TOP ROW: EMP No, Scheme checkboxes, S.No -->\r\n<table class=\"employee-section\">\r\n    <tr>\r\n        <td colspan=\"3\"></td>\r\n        <td style=\"text-align: right\">\r\n            Claim No:\r\n            <span class=\"line\">{{ doc.name }}</span>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<table class=\"employee-section\">\r\n    <tr>\r\n        <td>\r\n            EMP. No:\r\n            <span class=\"line\">{{ ins_mem.employee }}</span>\r\n        </td>\r\n        <td>\r\n            Scheme I\r\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme I\" %}\u2713{% endif %}</span>\r\n        </td>\r\n        <td>\r\n            Scheme II\r\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme II\" %}\u2713{% endif %}</span>\r\n        </td>\r\n        <td>\r\n            Scheme III\r\n            <span class=\"checkbox\">{% if emp_scheme.scheme == \"Scheme III\" %}\u2713{% endif %}</span>\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<!-- EMPLOYEE'S SECTION -->\r\n<div class=\"section-title\">Employee Details</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">1.</span>\r\n    <span class=\"content\">\r\n        Name :\r\n        <span>{{ emp.salutation }} {{ ins_mem.employee_name }}</span>\r\n    </span>\r\n</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">2.</span>\r\n    <span class=\"content\">\r\n        Designation :\r\n        <span>{{ emp.designation or '' }}</span>\r\n    </span>\r\n</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">3.</span>\r\n    <span class=\"content\">\r\n        Employee Category :\r\n        <span>{{ emp.employee_category or '' }}</span>\r\n    </span>\r\n</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">4.</span>\r\n    <span class=\"content\" style=\"display:flex; gap:20px;\">\r\n        {% if emp.department %}\r\n            <span>Department : <span>{{ emp.department }}</span></span>\r\n        {% endif %}\r\n        \r\n        {% if emp.branch %}\r\n            <span>Division : <span>{{ emp.branch }}</span></span>\r\n        {% endif %}\r\n        <!--<span>Age: <span class=\"dotted-line short\"></span></span>-->\r\n    </span>\r\n</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">5.</span>\r\n    <span class=\"content\">\r\n        Address :\r\n        <span>{{ emp.permanent_address or '' }}</span>\r\n    </span>\r\n</div>\r\n\r\n<div class=\"numbered-item\">\r\n    <span class=\"num\">6.</span>\r\n    <span class=\"content\" style=\"display:flex; gap:10px; flex-wrap:wrap;\">\r\n        <span>Telephone No : <span>{{ emp.cell_number or '' }}</span></span>\r\n        \r\n    </span>\r\n</div>\r\n\r\n{% if doc.dependent_name %}\r\n    <!-- DEPENDANT SECTION -->\r\n    <div class=\"section-title\">Dependant \u2013 <span style=\"font-weight:normal; text-transform:none;\">(Subject in respect of whom claim is made)</span></div>\r\n    \r\n    <div class=\"numbered-item\">\r\n        <span class=\"num\">1.</span>\r\n        <span class=\"content\">\r\n            Name (in full):\r\n            <span>{{ doc.dependent_name.split('(')[0].rstrip() or '' }}</span>\r\n        </span>\r\n    </div>\r\n    \r\n    <div class=\"numbered-item\">\r\n        <span class=\"num\">2.</span>\r\n        <span class=\"content\">\r\n            Relationship:\r\n            <span>{{ doc.dependent_name.split('(')[1].split(')')[0] or '' }}</span>\r\n        </span>\r\n    </div>\r\n{% endif %}\r\n\r\n<hr class=\"divider\">\r\n\r\n<!-- PRACTITIONER / SURGEON SECTION -->\r\n<div class=\"practitioner-section\">\r\n    <div class=\"section-header\">To Be Completed by the Patient's/ General Practitioner/ Surgeon</div>\r\n\r\n    <div class=\"lettered-item\">\r\n        <span class=\"ltr\">a.</span>\r\n        <span class=\"content\">\r\n            <span class=\"label-text\">Name of patient :</span>\r\n            <span class=\"dotted-line\"></span>\r\n        </span>\r\n    </div>\r\n\r\n    <div class=\"lettered-item\">\r\n        <span class=\"ltr\">b.</span>\r\n        <span class=\"content\">\r\n            <span class=\"label-text\">Condition that necessitated investigation or treatment :</span>\r\n            <span class=\"dotted-line\"></span>\r\n        </span>\r\n    </div>\r\n\r\n    <div class=\"lettered-item\">\r\n        <span class=\"ltr\">c.</span>\r\n        <span class=\"content\">\r\n            <span class=\"label-text\">General practitioner by whom referred :</span>\r\n            <span class=\"dotted-line\"></span>\r\n        </span>\r\n    </div>\r\n\r\n    <div class=\"lettered-item\">\r\n        <span class=\"ltr\">d.</span>\r\n        <span class=\"content\">\r\n            <span class=\"label-text\">Diagnosis of disease :</span>\r\n            <span class=\"dotted-line\"></span>\r\n        </span>\r\n    </div>\r\n\r\n    <div class=\"lettered-item\">\r\n        <span class=\"ltr\">e.</span>\r\n        <span class=\"content\">\r\n            <span class=\"label-text\">Details of treatment or operation and prognosis :</span>\r\n            <span class=\"dotted-line\"></span>\r\n        </span>\r\n    </div>\r\n\r\n    <div class=\"lettered-item\">\r\n        <span class=\"ltr\">f.</span>\r\n        <span class=\"content\">\r\n            <span class=\"label-text\">Was the onset of illness acute, sub-acute or chronic?</span>\r\n            <span class=\"dotted-line\"></span>\r\n        </span>\r\n    </div>\r\n\r\n    <div class=\"lettered-item\">\r\n        <span class=\"ltr\">g.</span>\r\n        <span class=\"content\">\r\n            <span class=\"label-text\">For how long would the patient have suffered from these symptoms and signs?</span>\r\n            <span class=\"dotted-line\"></span>\r\n        </span>\r\n    </div>\r\n\r\n    <div class=\"lettered-item\">\r\n        <span class=\"ltr\">h.</span>\r\n        <span class=\"content\" style=\"display:block;\">\r\n            <span style=\"display:flex; align-items:flex-end; width:100%;\">\r\n                <span class=\"label-text\">Period of hospitalization :</span>\r\n                <span class=\"dotted-line\" style=\"flex:1; min-width:0; margin-left:4px;\"></span>\r\n            </span>\r\n        </span>\r\n    </div>\r\n    \r\n    <div class=\"lettered-item\">\r\n        <span class=\"ltr\"></span>\r\n            <span class=\"sub-row\">\r\n                <span class=\"sub-field\">\r\n                    <span class=\"label-text\">Date of admission :</span>\r\n                    <span class=\"dotted-line\"></span>\r\n                </span>\r\n                <span class=\"sub-field\">\r\n                    <span class=\"label-text\">Date of Discharge :</span>\r\n                    <span class=\"dotted-line\"></span>\r\n                </span>\r\n            </span>\r\n        </span>\r\n    </div>        \r\n\r\n    <div class=\"lettered-item\">\r\n        <span class=\"ltr\">i.</span>\r\n        <span class=\"content\" style=\"display:block;\">\r\n            <span style=\"display:flex; align-items:flex-end; width:100%;\">\r\n                <span class=\"label-text\">State approximately when, in your opinion the ailment could have BEGUN or been CONTRACTED by the patient :</span>\r\n                <span class=\"dotted-line\" style=\"flex:1; min-width:0; margin-left:4px;\"></span>\r\n            </span>\r\n            <span class=\"dotted-line full\" style=\"margin-top:16px;\"></span>\r\n        </span>\r\n    </div>\r\n\r\n    <!-- Practitioner Declaration -->\r\n    <div class=\"practitioner-footer\">\r\n        <p style=\"font-size:10pt; line-height:1.7;\">\r\n            I certify that I am the General Practitioner/ Surgeon of the patient of the referred to above, and that I approved the services for which this claim is made.\r\n        </p>\r\n\r\n        <table style=\"margin-top:16px; margin-bottom:0;\">\r\n            <tr>\r\n                <td style=\"width:50%; vertical-align:top;\">\r\n                    Date: <span class=\"dotted-line medium\"></span>\r\n                   \r\n                </td>\r\n                <td style=\"width:50%; text-align:right; vertical-align:bottom;\">\r\n                    <div style=\"margin-top:10px; border-top:1px solid #000; padding-top:4px;\"></div>\r\n                    <div style=\"font-weight:bold; font-size:10pt; \">\r\n                        Signature of the Practitioner/ Surgeon/<br>\r\n                        Specialist who attended on this patient for this ailment\r\n                    </div>\r\n                </td>\r\n            </tr>\r\n        </table>\r\n\r\n        <div style=\"margin-top:14px; font-size:10pt;\">\r\n            <div style=\"margin-bottom:10px;\">\r\n                Name of Practitioner/ Surgeon : <span class=\"dotted-line long\"></span></span></span>\r\n            </div>\r\n            <div style=\"margin-bottom:10px;\">\r\n                Qualifications : <span class=\"dotted-line long\"></span>\r\n            </div>\r\n            <div style=\"margin-bottom:10px;\">\r\n                Address : <span class=\"dotted-line long\"></span>\r\n            </div>\r\n            <div style=\"margin-bottom:10px;\">\r\n                T.Phone No. : <span class=\"dotted-line long\"></span>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"italic-note\" style=\"margin-top:8px;\">\r\n            (To be completed by surgeon all cases as surgical and surgical treatment)\r\n        </div>\r\n    </div>\r\n</div>\r\n",
